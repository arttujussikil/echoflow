# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=echoflow
DB_PASSWORD=your_secure_password_here
DB_NAME=echoflow

# Server Configuration
PORT=3000
NODE_ENV=development

# ── AI Provider ────────────────────────────────────────────────────────────────
# EchoFlow tries NVIDIA NIM first (if key is set), then falls back to Ollama.
# Both are free — NVIDIA is rate-limited cloud, Ollama is unlimited local.

# NVIDIA NIM (free endpoint — get key at https://build.nvidia.com)
# Recommended: much higher accuracy than local Ollama models.
NVIDIA_API_KEY=
# Comma-separated list, tried in order (then Ollama). Sentiment accuracy on 50 hand-labelled
# posts (npm run eval, see docs/ai-design.md):
#   nvidia/nemotron-3-super-120b-a12b     — 98%, ~14 s per 50 posts  (default, first)
#   nvidia/nemotron-3-ultra-550b-a55b     — 97%, ~20 s; free endpoint often busy (default backup)
#   nvidia/nemotron-3.5-lightning-30b-a3b — 87%
# Models get retired over time (mistralai/mistral-nemotron now returns HTTP 410).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b

# Google Gemini (free tier — key at https://aistudio.google.com/apikey, no credit card)
# Used as backup after NVIDIA, and for the side-by-side "Compare NVIDIA vs Gemini" view.
# Free-tier prompts may be used by Google to improve its products (fine for public headlines).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Your own model: any OpenAI-compatible API. Tried after NVIDIA and Gemini, can be picked
# on its own in Settings → AI, shows up in the model comparison and in npm run eval.
# Examples (CUSTOM_AI_URL / CUSTOM_AI_MODEL):
#   OpenRouter free models   https://openrouter.ai/api/v1      meta-llama/llama-4-scout:free
#   Groq (free tier)         https://api.groq.com/openai/v1    llama-3.3-70b-versatile
#   LM Studio on this PC     http://localhost:1234/v1          (the model name LM Studio shows)
# From inside Docker, "localhost" is the container: use http://host.docker.internal:1234/v1
# The key can stay empty for local servers. Comma-separate several models to try in order.
CUSTOM_AI_NAME=
CUSTOM_AI_URL=
CUSTOM_AI_KEY=
CUSTOM_AI_MODEL=

# Offline sentiment model (Hugging Face, runs inside the web container, no key)
# Labels the moods when NVIDIA and Gemini don't answer. Downloaded once (~280 MB).
# Any Hugging Face text-classification model with ONNX weights works: <repo>[@dtype]
# Set to "off" to disable.
LOCAL_SENTIMENT_MODEL=onnx-community/twitter-xlm-roberta-base-sentiment-ONNX@q8

# Embedding model (Hugging Face, runs inside the web container, ~120 MB)
# Groups posts into stories, finds the posts that answer "Ask the results" and the
# posts about a target in "Mood toward…". "off" disables those features.
EMBEDDING_MODEL=Xenova/multilingual-e5-small@q8

# Mood over time: every analysis is saved in PostgreSQL. Optionally analyse some
# topics automatically (uses free AI quota: ~3–6 requests per topic per run).
# Comma-separated; use | inside a topic for a multi-keyword search, e.g. News|Finland
TRACK_TOPICS=
TRACK_EVERY_HOURS=6

# Ollama (local fallback — runs inside Docker, zero cost, no internet needed)
OLLAMA_HOST=http://ollama:11434
# llama3.2:3b  ~2 GB, recommended — good quality, fast enough for analysis
# llama3.2:1b  ~600 MB, lighter but poor structured output
# llama3.1:8b  ~4.7 GB, best local quality if you have the RAM
OLLAMA_MODEL=llama3.2:3b

# ── Reddit (optional) ──────────────────────────────────────────────────────────
# Without credentials Reddit search falls back to RSS (no scores/comment counts).
# Get a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── News APIs (optional, all have free tiers) ──────────────────────────────────
# From https://github.com/public-apis/public-apis#news
# Each source switches on automatically when its key is set. Users can also paste
# their own keys in the UI (Settings → Sources); those stay in their browser.
# Keep comments on their own line: Docker reads `KEY=  # note` as the key "# note".
# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# https://developer.nytimes.com/get-started
NYT_API_KEY=
# https://gnews.io/register
GNEWS_API_KEY=
# https://newsdata.io/register
NEWSDATA_API_KEY=
# https://currentsapi.services/en/register
CURRENTS_API_KEY=
# https://www.thenewsapi.com/register
THENEWSAPI_KEY=
# https://newsapi.org/register
NEWSAPI_KEY=
# https://mediastack.com/signup/free
MEDIASTACK_API_KEY=
