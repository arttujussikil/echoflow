# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=echoflow
DB_PASSWORD=your_secure_password_here
DB_NAME=echoflow

# Server Configuration
PORT=3000
NODE_ENV=development

# Ollama (local AI — runs inside Docker, no cost)
OLLAMA_HOST=http://ollama:11434
# llama3.2:3b  ~2 GB, recommended — good quality, fast enough for analysis
# llama3.2:1b  ~600 MB, lighter but poor structured output
# llama3.1:8b  ~4.7 GB, best quality if you have the RAM
OLLAMA_MODEL=llama3.2:3b